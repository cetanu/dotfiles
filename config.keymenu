keybind("N", "Neovim", command: "nvim")

group("a", description: "Agents")
keybind("ac", "Codex", "codex --no-daemon")
keybind("ag", "AntiGravity", "agy --dangerously-skip-permissions")

group("g", description:"Git")
keybind("gs", "Status", command: "git status")
keybind("gd", "Diff", command: "git diff")
keybind("gl", "Log", command: "git log --pretty=oneline")
keybind("gS", "Stash", command: "git stash")
keybind("gr", "Hard Reset", command: "git reset --hard HEAD")
keybind("gcf", "Amend & Force Push", command: "git commit --amend; git push -f")
keybind("gp", "Pull", command: "git pull -ff --autostash")
keybind("gP", "Push", command: "git push")

group("c", description:"Cargo")
keybind("ct", "Test", command: "cargo test")
keybind("cc", "Clippy", command: "cargo clippy")
keybind("cb", "Build", command: "cargo build")
